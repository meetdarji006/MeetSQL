# ─── App ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://meetsql:meetsql@localhost:5432/meetsql

# ─── Oracle XE ─────────────────────────────────────
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_ADMIN_USER=SYSTEM
ORACLE_ADMIN_PASSWORD=OraclePass123
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_QUERY_TIMEOUT_MS=10000

# ─── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-256-bit-random
JWT_REFRESH_SECRET=change-me-refresh-secret-256-bit-random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
